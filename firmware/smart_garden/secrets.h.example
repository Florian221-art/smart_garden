// =============================================================================
//  secrets.h.example – OPTIONALE Vorlage für Zugangsdaten
// =============================================================================
//  Wozu? Das GitHub-Repo ist öffentlich. Wer das echte WLAN-Passwort oben in
//  smart_garden.ino einträgt, kann es aus Versehen committen. secrets.h wird
//  dagegen von Git ignoriert (.gitignore) und hat Vorrang vor dem Sketch.
//
//  So geht's:
//    1. Diese Datei im selben Ordner kopieren und in  secrets.h  umbenennen
//    2. Werte eintragen, nicht benötigte Zeilen löschen oder auskommentieren
//    3. Arduino IDE neu öffnen (damit sie die neue Datei als Tab sieht), hochladen
//  Beim Start steht dann im seriellen Monitor: "[CFG] Zugangsdaten aus secrets.h übernommen"
//
//  Nur #define verwenden (die Datei wird in zwei .cpp-Dateien eingebunden).
// =============================================================================
#pragma once

#define SECRET_WIFI_SSID     "SmartGarden"
#define SECRET_WIFI_PASSWORD "echtes-wlan-passwort"
#define SECRET_SERVER_URL    "http://10.42.0.1:8000"
#define SECRET_API_KEY       "api-key-vom-server"
// #define SECRET_DEVICE_ID  "esp32-kuebel-01"

// Optional für HTTPS mit Zertifikatsprüfung (Caddy "tls internal"):
// Root-Zertifikat vom Pi holen (/var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt),
// unten einfügen (jede Zeile in "..." mit \n am Ende) und die /* */ entfernen.
// Dann SECRET_SERVER_URL auf "https://10.42.0.1" stellen.
/*
#define SERVER_CA_CERT \
  "-----BEGIN CERTIFICATE-----\n" \
  "MIIB...\n" \
  "-----END CERTIFICATE-----\n"
*/
